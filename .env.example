# Naismith environment template.
# Copy to `.env` (git-ignored) and fill in locally. NEVER commit filled values.
# Secret-bearing keys MUST stay empty here — a constitutional test enforces it.

# Application
NAISMITH_ENV=development
NAISMITH_LOG_LEVEL=INFO
NAISMITH_HOST=127.0.0.1
NAISMITH_PORT=8000
NAISMITH_CORS_ORIGINS=http://localhost:5173

# Web app
VITE_API_BASE_URL=http://localhost:8000

# Database and cache (used from Phase 1+; the slice runs without them)
DATABASE_URL=
REDIS_URL=

# Model providers (none used yet — the slice ships a mock adapter)
PRIMARY_LLM_PROVIDER=
PRIMARY_LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Voice providers (Phase 4)
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# Legend Vault (Phase 2, read-only first)
LEGEND_VAULT_PATH=
LEGEND_VAULT_MODE=read_only

# Security
SESSION_SECRET=
ENCRYPTION_KEY=
AUDIT_SIGNING_KEY=

# Feature flags (risky capabilities default off)
ENABLE_REAL_INTERVIEWS=false
ENABLE_AUDIO_RETENTION=false
ENABLE_VAULT_WRITES=false
ENABLE_SIMULATION_LAB=true
